# Computer Quest Backend Environment Template
# Copy this file to .env and fill in production database credentials

# Spring Boot Port (Default: 8080 or assigned by host e.g. Render/Railway)
PORT=8080

# Cloud PostgreSQL Database Connection URL
# Example Neon: jdbc:postgresql://ep-xyz.region.aws.neon.tech/neondb?sslmode=require
# Example Render: jdbc:postgresql://dpg-xyz-a.oregon-postgres.render.com/computer_quest_db
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/computer_quest
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_password_here

# Hibernate DDL Auto (update for development, validate/none for strict production)
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# Allowed Frontend Origins for CORS (comma-separated or *)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://your-frontend-domain.vercel.app
